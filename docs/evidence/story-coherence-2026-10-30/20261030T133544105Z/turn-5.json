              "content": "{\n  \"blocks\": [\n    {\n      \"kind\": \"narration\",\n      \"text\": \"你穿过密林，避开几处塌方路段，六十日后终于抵达后山深处。这里古木参天，光线昏暗，空气中弥漫着浓重的血腥味。前方不远处，一头体型硕大的黑影正趴伏在一处断崖边，似乎在啃食着什么。那黑影浑身长满黑毛，獠牙漆黑如铁，正是张屠户口中那只死而复生的野猪。它似乎察觉到了你的气息，猛地抬起头，双眼泛着幽绿的光，死死盯着你。\"\n    },\n    {\n      \"kind\": \"narration\",\n      \"text\": \"野猪发出一声低沉的咆哮，后腿猛蹬地面，带着一股腥风向你冲来。它的速度极快，瞬间便拉近了十丈距离。你下意识地握紧了手中的猎刀，感受着体内那股莫名的躁动。就在野猪即将撞上你的瞬间，你感觉体内似乎有什么东西被唤醒了，手中的猎刀竟隐隐发出嗡鸣声，刀刃上泛起一层淡淡的寒光。\"\n    }\n  ],\n  \"choices\": [\n    {\n      \"action\": \"fight:assault\",\n      \"targetId\": \"k1_person_张屠户\",\n      \"stake\": \"low\",\n      \"purpose\": \"攻击冲过来的野猪，试图将其击退或击杀\",\n      \"anchor\": 1\n    },\n    {\n      \"action\": \"evade:withdraw\",\n      \"targetId\": \"k1_person_张屠户\",\n      \"stake\": \"low\",\n      \"purpose\": \"向侧方闪避野猪的冲撞，拉开距离\",\n      \"anchor\": 1\n    },\n    {\n      \"action\": \"interact:ask\",\n      \"targetId\": \"k1_person_张屠户\",\n      \"stake\": \"low\",\n      \"purpose\": \"询问野猪为何会出现在这里，它身上散发出的气息有何不同\",\n      \"anchor\": 1\n    }\n  ],\n  \"title\": \"后山深处\",\n  \"location\": \"后山深处\",\n  \"otherPeople\": [\n    {\n      \"id\": \"k1_person_张屠户\",\n      \"status\": \"alive\"\n    }\n  ],\n  \"places\": [],\n  \"factions\": [],\n  \"memoryDeltas\": [\n    {\n      \"entityId\": \"k1_person_张屠户\",\n      \"kind\": \"clue\",\n      \"anchor\": 1,\n      \"status\": \"open\"\n    }\n  ]\n}",
