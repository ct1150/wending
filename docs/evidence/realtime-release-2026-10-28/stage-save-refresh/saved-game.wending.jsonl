th":{"originId":"village","talentIds":["fortune-debt","iron-bones"],"attributes":{"constitution":3,"insight":6,"fortune":3}}},"currentScene":{"id":"r:17d4b63b7a333a81:t2:s:scene","title":"杂货铺里的低语","location":"青石村","entities":[{"id":"r:17d4b63b7a333a81:t1:e:place_qingshi_village","name":"青石村","kind":"place"},{"id":"r:17d4b63b7a333a81:t1:e:person_lao_wang","name":"老王","kind":"person"},{"id":"r:17d4b63b7a333a81:t1:e:person_ling_shang","name":"林商","kind":"person"}],"blocks":[{"kind":"narration","text":"老王压低声音，将一张泛黄的符纸推到你面前。他指着符纸边缘的焦痕，说这是上个月从北边逃难者手里收来的，能挡一次低阶妖兽的爪击，但灵力耗尽后就会自燃。"},{"kind":"dialogue","text":"北边的雾越来越浓了，连猎户都不敢进山。听说那妖兽能模仿人声，你要是想活命，别信任何在雾里喊你名字的声音。","speaker":"r:17d4b63b7a333a81:t1:e:person_lao_wang"},{"kind":"narration","text":"铺子外传来车轮碾过石板的声响，林商正站在门口整理货物。他看见你，扬了扬下巴，示意你出来谈车资。"}],"choices":[{"id":"r:17d4b63b7a333a81:t2:c:a","label":"向老王购买那张低阶符纸","intent":"negotiate","targetId":"r:17d4b63b7a333a81:t1:e:person_lao_wang","stake":"low","approach":"cooperate"},{"id":"r:17d4b63b7a333a81:t2:c:b","label":"出门与林商商议前往云州城的车资","intent":"negotiate","targetId":"r:17d4b63b7a333a81:t1:e:person_ling_shang","stake":"low","approach":"cooperate"},{"id":"r:17d4b63b7a333a81:t2:c:c","label":"在青石村寻找行粮补充体力","intent":"explore","targetId":"supplies","stake":"low","approach":"cautious"}],"memoryDeltas":[{"entityId":"r:17d4b63b7a333a81:t1:e:person_lao_wang","text":"老王透露北边妖兽能模仿人声，并出售一张能挡一次爪击的低阶符纸。","kind":"fact"}]},"lastReceipt":{"kind":"choice","choiceId":"r:17d4b63b7a333a81:t1:c:a","action":{"id":"r:17d4b63b7a333a81:t1:c:a","label":"与老王交谈，询问符纸详情及北边妖兽传闻","intent":"negotiate","targetId":"r:17d4b63b7a333a81:t1:e:person_lao_wang","stake":"low","approach":"cooperate"},"elapsedDays":7,"itemChanges":{"stones":1,"supplies":-1},"relationChanges":{"r:17d4b63b7a333a81:t1:e:person_lao_wang":3},"random":{"before":1080474372,"after":3012430483,"roll":83},"before":{"ageDays":5760,"realm":"mortal","cultivation":0,"injury":0},"after":{"ageDays":5767,"realm":"mortal","cultivation":0,"injury":0},"death":null,"b