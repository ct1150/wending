        "clues": [
          {
            "id": "m:0e3301eaff36150e0d7d88fa343c73bb",
            "source": "narrative",
            "kind": "clue",
            "entityId": "r:6049e35f97c78102:t1:e:person_1",
            "text": "“咚、咚……”泥土松动，一只满是泥垢的手猛地扒住了井沿，紧接着一个黑影从井底爬了出来，浑身湿透，手里死死攥着半块残缺的玉佩。那是个衣衫褴褛的陌生人，他抬头看了你一眼，眼神涣散，嘴唇颤抖着吐出一个字：“救……”",
            "status": "open",
            "runId": "d4aa2c7e-ac0d-4251-ba24-3c7f597b0cd8",
            "turnId": 1
          }
        ],
        "recent": [
          {
            "id": "turn:1",
            "runId": "d4aa2c7e-ac0d-4251-ba24-3c7f597b0cd8",
            "turnId": 1,
            "source": "narrative",
            "kind": "turn",
            "text": "地点：猎户屋后\n云归，十六岁的猎户少年，正蹲在自家屋后的枯井旁。井口结着薄霜，井底传来几声沉闷的回响，像是有什么东西在撞击井壁。你握紧了手中的铁叉，听息敏锐的直觉让你察觉到那声音并非来自井底，而是来自井口边缘的泥土里，正以一种极其缓慢的速度向外拱动。\n“咚、咚……”泥土松动，一只满是泥垢的手猛地扒住了井沿，紧接着一个黑影从井底爬了出来，浑身湿透，手里死死攥着半块残缺的玉佩。那是个衣衫褴褛的陌生人，他抬头看了你一眼，眼神涣散，嘴唇颤抖着吐出一个字：“救……”",
            "entityIds": []
          }
        ],
        "summaries": []
