  "memoryDeltas": [
    {
      "entityId": "r:17d4b63b7a333a81:t2:e:person_wild_boar",
      "text": "铁背野猪是山林中的妖兽，体型硕大，具有金属光泽的黑毛，目前处于警戒状态。",
      "kind": "fact"
    }
  ]
