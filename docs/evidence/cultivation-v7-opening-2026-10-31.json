  "acceptedScene": {
    "id": "r:c233d45888426812:t1:s:scene",
    "title": "寒火难调",
    "location": "出生地",
    "entities": [
      {
        "id": "r:c233d45888426812:t1:e:person_1",
        "name": "老赵",
        "kind": "person"
      }
    ],
    "blocks": [
      {
        "kind": "narration",
        "text": "十六岁的陆岑站在出生地村口的老槐树下，寒风卷着枯叶打在脸上。身旁的村民老赵正蹲在地上，手里摆弄着一只缺了口的粗陶罐，罐口封着层薄薄的冰霜。老赵抬头瞥了你一眼，指了指罐子，声音沙哑：“后生，你那灵根看着有些寒气，这罐子里的东西若是处理不好，怕是要炸了。这可是我攒了半年的心血，想炼点‘暖阳散’给家里重病的婆娘，可这‘留焰体’的火候总压不住这‘寒水根’的寒气，一碰就散。”老赵叹了口气，把陶罐往你面前推了推，眼神里带着几分希冀，“你若是能帮忙看看这火候，我愿分你半块干粮。”"
      }
    ],
    "choices": [
      {
        "id": "r:c233d45888426812:t1:c:a",
        "label": "询问老赵：询问老赵关于这罐子炼丹失败的具体原因，以及他为何认为陆岑的灵根能帮忙。",
        "intent": "interact",
        "targetId": "r:c233d45888426812:t1:e:person_1",
        "stake": "low",
        "approach": "ask"
      },
      {
        "id": "r:c233d45888426812:t1:c:b",
        "label": "观察老赵：仔细观察老赵手中的陶罐和周围环境，寻找炼丹失败的蛛丝马迹。",
        "intent": "interact",
        "targetId": "r:c233d45888426812:t1:e:person_1",
        "stake": "low",
        "approach": "observe"
      },
      {
        "id": "r:c233d45888426812:t1:c:c",
        "label": "婉拒老赵：拒绝老赵的请求，表示自己只是个凡人，帮不上忙。",
        "intent": "interact",
