        "message": {
          "content": "\n{\n  \"id\": \"r:a8d440f51f9c62ee:t1:s:scene\",\n  \"title\": \"云归的抉择\",\n  \"location\": \"青云村\",\n  \"entities\": [\n    {\n      \"id\": \"r:a8d440f51f9c62ee:t1:e:person_云归\",\n      \"name\": \"云归\",\n      \"kind\": \"person\",\n      \"status\": \"alive\"\n    },\n    {\n      \"id\": \"r:a8d440f51f9c62ee:t1:e:place_青云村\",\n      \"name\": \"青云村\",\n      \"kind\": \"place\"\n    }\n  ],\n  \"blocks\": [\n    {\n      \"kind\": \"narration\",\n      \"text\": \"十六岁的云归站在青云村的村口，晨雾还未散去。他生来便有一股异于常人的灵性，记忆过目不忘，骨骼更是隐隐透着剑意。今日是村中一年一度的“试剑日”，也是他正式踏入修仙界的门槛。村长正站在高台上，目光灼灼地望着他，似乎在等待他的决定。\"\n    },\n    {\n      \"kind\": \"dialogue\",\n      \"text\": \"云归，你可想好了？修仙路漫漫，九死一生，一旦踏出此门，便再无回头路。\",\n      \"speaker\": \"r:a8d440f51f9c62ee:t1:e:person_云归\"\n    }\n  ],\n  \"choices\": [\n    {\n      \"id\": \"r:a8d440f51f9c62ee:t1:c:a\",\n      \"label\": \"拜入青云宗\",\n      \"intent\": \"travel\",\n      \"targetId\": \"r:a8d440f51f9c62ee:t1:e:place_青云宗\",\n      \"stake\": \"normal\",\n      \"approach\": \"road\"\n    },\n    {\n      \"id\": \"r:a8d440f51f9c62ee:t1:c:b\",\n      \"label\": \"前往黑风寨\",\n      \"intent\": \"travel\",\n      \"targetId\": \"r:a8d440f51f9c62ee:t1:e:place_黑风寨\",\n      \"stake\": \"high\",\n      \"approach\": \"wilderness\"\n    },\n    {\n      \"id\": \"r:a8d440f51f9c62ee:t1:c:c\",\n      \"label\": \"独自游历\",\n      \"intent\": \"travel\",\n      \"targetId\": \"r:a8d440f51f9c62ee:t1:e:place_荒野\",\n      \"stake\": \"low\",\n      \"approach\": \"wilderness\"\n    }\n  ],\n  \"memoryDeltas\": []\n}\n",
