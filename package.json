{
  "name": "baishi-wending",
  "version": "8.4.0",
  "private": true,
  "type": "module",
  "description": "百世问鼎 — 寿元劫数驱动的肉鸽修仙卡牌构筑游戏",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build",
    "build:single": "vite build --mode single --outDir dist-single",
    "build:release": "node scripts/build-release.js",
    "publish:release": "node scripts/publish-release.js",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.js",
    "release": "npm run typecheck && npm test && npm run build && npm run build:single && npm run build:release"
  },
  "dependencies": {
    "preact": "^10.25.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.3",
    "playwright": "^1.50.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^3.0.5"
  }
}
