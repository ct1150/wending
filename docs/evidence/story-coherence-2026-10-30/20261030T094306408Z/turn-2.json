      "memory": {
        "facts": [
          {
            "id": "decision:2",
            "runId": "842e4747-b574-4b65-849f-22d2089124ca",
            "turnId": 2,
            "source": "rules",
            "kind": "fact",
            "entityId": "r:c901c16f455b3d18:t1:e:person_1",
            "text": "你在城西坊市选择了“观察脚夫：仔细观察灵雀和脚夫的状态”。"
          }
        ],
        "promises": [],
        "clues": [
          {
            "id": "m:6cd62087d25cc3c05adb006de4ea4617",
            "source": "narrative",
            "kind": "clue",
            "entityId": "r:c901c16f455b3d18:t1:e:person_1",
            "text": "你凑近竹筐，灵雀的羽毛有些凌乱，几只灵雀的翅膀下似乎藏着什么异物。你伸手拨开羽毛，发现几根细小的银针正扎在它们脚踝的皮肤下，针尾连着极细的丝线，正随着灵雀的挣扎微微颤动。那脚夫见状，脸色一变，连忙伸手想要遮掩，却被你抢先一步按住了手腕。",
            "status": "open",
            "runId": "842e4747-b574-4b65-849f-22d2089124ca",
            "turnId": 2
          },
          {
            "id": "m:84ec0d88b07ee0b923e35a26732d80f3",
            "source": "narrative",
            "kind": "clue",
            "entityId": "r:c901c16f455b3d18:t1:e:person_1",
            "text": "你站在城西坊市边缘，晨雾未散。街角那家名为“听风阁”的杂货铺前，一个穿着灰布长衫的中年人正对着你招手，神色有些焦急。他身旁的竹筐里，几只灵雀正不安地扑腾着翅膀，发出细微的鸣叫。你认得他，这是负责给坊市运送灵材的脚夫，平日里总是一副笑呵呵的模样，此刻却眉头紧锁，似乎遇到了什么难处。",
            "status": "open",
            "runId": "842e4747-b574-4b65-849f-22d2089124ca",
            "turnId": 1
          }
        ],
        "recent": [
          {
            "id": "turn:2",
            "runId": "842e4747-b574-4b65-849f-22d2089124ca",
            "turnId": 2,
            "source": "narrative",
            "kind": "turn",
            "text": "地点：城西坊市；刚才选择：观察脚夫：仔细观察灵雀和脚夫的状态\n你凑近竹筐，灵雀的羽毛有些凌乱，几只灵雀的翅膀下似乎藏着什么异物。你伸手拨开羽毛，发现几根细小的银针正扎在它们脚踝的皮肤下，针尾连着极细的丝线，正随着灵雀的挣扎微微颤动。那脚夫见状，脸色一变，连忙伸手想要遮掩，却被你抢先一步按住了手腕。",
            "entityIds": []
          },
          {
            "id": "turn:1",
            "runId": "842e4747-b574-4b65-849f-22d2089124ca",
            "turnId": 1,
            "source": "narrative",
            "kind": "turn",
            "text": "地点：城西坊市\n你站在城西坊市边缘，晨雾未散。街角那家名为“听风阁”的杂货铺前，一个穿着灰布长衫的中年人正对着你招手，神色有些焦急。他身旁的竹筐里，几只灵雀正不安地扑腾着翅膀，发出细微的鸣叫。你认得他，这是负责给坊市运送灵材的脚夫，平日里总是一副笑呵呵的模样，此刻却眉头紧锁，似乎遇到了什么难处。\n“小友，可否行个方便？”中年人见你停下脚步，连忙迎上来，压低声音说道，“这批灵雀有些躁动，我查了半天也没找出原因。若是耽误了时辰，被坊市管事责罚事小，若是伤了这些生灵，我这张老脸往哪搁？”他指了指竹筐，眼神里满是恳求。",
            "entityIds": []
          }
        ],
        "summaries": []
      },
