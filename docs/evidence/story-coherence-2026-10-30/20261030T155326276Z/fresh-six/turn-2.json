      "memory": {
        "facts": [
          {
            "id": "decision:2",
            "runId": "a5055d8e-11bc-4c7c-b055-d1fc05cfd787",
            "turnId": 2,
            "source": "rules",
            "kind": "fact",
            "entityId": "r:eb23fe6aca0e5570:t1:e:person_1",
            "text": "你在山村选择了“询问王大锤：询问这块铁的具体用途和成色”。"
          },
          {
            "id": "m:7bd953f203593a9e7de55207b0f7c2d1",
            "source": "narrative",
            "kind": "fact",
            "entityId": "r:eb23fe6aca0e5570:t1:e:person_1",
            "text": "十六岁的云归背着竹篓站在村口老槐树下，手里握着把磨得发亮的猎刀。村头铁匠王大锤正蹲在地上，对着一块黑乎乎的废铁发愁，嘴里嘟囔着这铁怎么也打不成器。",
            "runId": "a5055d8e-11bc-4c7c-b055-d1fc05cfd787",
            "turnId": 1
          }
        ],
        "promises": [],
        "clues": [
          {
            "id": "m:f3381f02d94b6b8e5c941ad3d4d08b5c",
            "source": "narrative",
            "kind": "clue",
            "entityId": "r:eb23fe6aca0e5570:t1:e:person_1",
            "text": "王大锤把那块黑铁举到眼前，眯着眼端详了半天，才叹了口气说：“这铁看着像是某种兽骨炼化后的残渣，杂质太多，火候没压住，硬是打不成形。若是寻常铁匠铺，早当废料扔了，可这东西透着股子怪味儿，不像凡铁。”",
            "status": "open",
            "runId": "a5055d8e-11bc-4c7c-b055-d1fc05cfd787",
            "turnId": 2
          },
          {
            "id": "m:1f011587860ff1a916f178b751d99290",
            "source": "narrative",
            "kind": "clue",
            "entityId": "r:eb23fe6aca0e5570:t1:e:person_1",
            "text": "王大锤见你过来，抬头抹了一把汗，把那块废铁往你面前一推：“云归，你眼尖，帮叔看看这铁是不是废了？若是能炼，叔请你吃两个烧饼。”",
            "status": "open",
            "runId": "a5055d8e-11bc-4c7c-b055-d1fc05cfd787",
            "turnId": 1
          }
        ],
        "recent": [
