      "memory": {
        "facts": [
          {
            "id": "decision:2",
            "runId": "7a47cb2b-4295-42fa-af09-c7431bfe9f2c",
            "turnId": 2,
            "source": "rules",
            "kind": "fact",
            "entityId": "r:fd4b7fba18127f5b:t1:e:person_1",
            "text": "你在城坊选择了“询问铁匠老张：询问这只木鸢的具体损坏情况”。"
          }
        ],
        "promises": [],
        "clues": [
          {
            "id": "m:ecd408740ce4fac96015204a25a25349",
            "source": "narrative",
            "kind": "clue",
            "entityId": "r:fd4b7fba18127f5b:t1:e:person_1",
            "text": "铁匠老张抹了一把脸上的黑灰，指着木鸢的翅膀根部说道：“这机括里的‘灵枢’断了，原本是嵌在竹骨里的，现在碎成了渣。要想修好，得重新打磨竹骨，还得配个新的灵枢，材料费倒是小事，关键是这竹子得是三年以上的‘青竹’，市面上不好找，我这儿也没存货。”",
            "status": "open",
            "runId": "7a47cb2b-4295-42fa-af09-c7431bfe9f2c",
            "turnId": 2
          }
        ],
        "recent": [
          {
            "id": "turn:2",
            "runId": "7a47cb2b-4295-42fa-af09-c7431bfe9f2c",
            "turnId": 2,
            "source": "narrative",
            "kind": "turn",
            "text": "地点：城坊；刚才选择：询问铁匠老张：询问这只木鸢的具体损坏情况\n铁匠老张抹了一把脸上的黑灰，指着木鸢的翅膀根部说道：“这机括里的‘灵枢’断了，原本是嵌在竹骨里的，现在碎成了渣。要想修好，得重新打磨竹骨，还得配个新的灵枢，材料费倒是小事，关键是这竹子得是三年以上的‘青竹’，市面上不好找，我这儿也没存货。”",
            "entityIds": []
          },
          {
            "id": "turn:1",
            "runId": "7a47cb2b-4295-42fa-af09-c7431bfe9f2c",
            "turnId": 1,
            "source": "narrative",
            "kind": "turn",
            "text": "地点：城坊\n你站在城坊的街角，手里攥着刚领到的匠徒腰牌。不远处，一个满脸煤灰的汉子正蹲在摊位前，对着一只断了腿的木鸢发愁，嘴里嘟囔着这可是要交差的活计。他似乎察觉到了你的目光，抬起头，露出两排被烟熏黄的牙齿，冲你招了招手。\n“嘿，小友，看你骨骼精奇，不如帮个忙？这木鸢的机括坏了，我手笨修不好，若是你能修好，这剩下的灵石便归你。”汉子指了指摊位上那只残破的木鸢，眼神里透着几分狡黠与期待。",
            "entityIds": []
          }
        ],
        "summaries": []
      },
