    "currentScene": {
      "id": "r:f28528e6e121b03b:t2:s:scene",
      "title": "青石镇客栈",
      "location": "聚宝阁客栈柴房",
      "entities": [
        {
          "id": "r:f28528e6e121b03b:t2:e:person_1",
          "name": "掌柜",
          "status": "alive",
